<div class="side-panel">
    <h3 class="h3-sidebar">
        Dashboard
    </h3>
    <a href="<%= siteConfig.nav.routes.dashboard %>" class="<%= currentPath === siteConfig.nav.routes.dashboard ? 'active' : '' %>">
        <i class="hn hn-grid-solid"></i>
        Overview
    </a>
    <a href="<%= siteConfig.nav.routes.edit_profile %>" class="<%= currentPath === siteConfig.nav.routes.edit_profile ? 'active' : '' %>">
        <i class="hn hn-pen-solid"></i>
        Edit Profile
    </a>
    <a href="<%= siteConfig.nav.routes.edit_privacy %>" class="<%= currentPath === siteConfig.nav.routes.edit_privacy ? 'active' : '' %>">
        <i class="hn hn-glasses-solid"></i>
        Privacy
    </a>
    <a href="<%= siteConfig.nav.routes.view_badges %>" class="<%= currentPath === siteConfig.nav.routes.view_badges ? 'active' : '' %>">
        <i class="hn hn-clipboard-solid"></i>
        Your Badges
    </a>
    <a href="/@<%= user.discordUsername %>" class="<%= currentPath === ('/@' + user.discordUsername) ? 'active' : '' %>">
        <i class="hn hn-user-solid"></i>
        View Profile
    </a>
    <% if (typeof user !== 'undefined' && user && user.isAdmin) { %>
    <h3 class="h3-sidebar">
        Admin
    </h3>
    <a href="<%= siteConfig.nav.routes.admin_manage_achievements %>" class="<%= currentPath === siteConfig.nav.routes.admin_manage_achievements ? 'active' : '' %>">
        <i class="hn hn-clipboard-solid"></i>
        Manage Badges
    </a>
    <a href="<%= siteConfig.nav.routes.admin_manage_users %>" class="<%= currentPath === siteConfig.nav.routes.admin_manage_users ? 'active' : '' %>">
        <i class="hn hn-users-crown-solid"></i>
        Manage Users
    </a>
    <% } %>
</div>
