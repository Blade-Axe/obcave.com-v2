<head>
    <meta charset="UTF-8">
    <title><%= title %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="author" content="obcave.com">
    <meta name="description" content="The Official obcave Website">

    <link rel="stylesheet" href="/css/styles.css">
    <% if (typeof activeTheme !== 'undefined' && activeTheme && Object.keys(activeTheme.colours).length) { %>
        <style id="active-theme-vars">:root{<% Object.entries(activeTheme.colours).forEach(function(pair) { %>--<%= pair[0] %>: <%= pair[1] %>;<% }); %>}</style>
    <% } %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" rel="stylesheet" />
    <script src="/scripts/core.js" defer></script>
</head>