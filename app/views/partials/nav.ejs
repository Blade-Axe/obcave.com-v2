<nav>
    <div id="nav-elements" class="unselectable">
        <div class="nav-left">
            <button type="button" id="hamburger" aria-label="Toggle navigation menu" aria-expanded="false" aria-controls="nav-menu-container">
                <i class="hn hn-bars" aria-hidden="true"></i>
            </button>
            <label id="brand-label" class="brand unselectable">
                <a id="brand-link" class="brand-link <%= currentPath === siteConfig.nav.brand.path ? 'active' : '' %>" href="<%= siteConfig.nav.brand.path %>">
                    <img src="<%= siteConfig.nav.brand.logoSrc %>" class="nav-logo">
                    <span><%= siteConfig.nav.brand.label %></span>
                </a>
            </label>
            <div class="account-menu-wrapper">
                <button type="button" id="account-btn" class="<%= (typeof user !== 'undefined' && user) ? 'has-avatar' : '' %>" aria-label="Toggle account menu" aria-expanded="false" aria-controls="account-menu-container">
                    <% if (typeof user !== 'undefined' && user) { %>
                        <img src="<%= user.discordAvatar %>" alt="Account menu" class="account-btn-avatar">
                    <% } else { %>
                        <i class="hn hn-cog" aria-hidden="true"></i>  
                    <% } %>
                </button>
                <div id="account-menu-container">
                    <% if (typeof user !== 'undefined' && user) { %>
                        <a href="<%= siteConfig.nav.routes.dashboard %>" class="btn-primary account-menu-signin"><%= siteConfig.nav.text.logged_in %></a>
                    <% } else { %>
                        <a href="<%= siteConfig.nav.routes.auth_sign_in %>" class="btn-primary account-menu-signin"><%= siteConfig.nav.text.logged_out %></a>
                    <% } %>
                    <div class="account-menu-divider"></div>
                    <div class="account-menu-section">
                        <span class="account-menu-heading"><%= siteConfig.nav.text.theme %></span>
                        <div class="theme-swatches">
                            <% (typeof publishedThemes !== 'undefined' ? publishedThemes : []).forEach(function(theme) { %>
                                <button type="button"
                                    class="theme-swatch <%= (typeof activeTheme !== 'undefined' && activeTheme && activeTheme.id === theme.id) ? 'active' : '' %>"
                                    data-theme-id="<%= theme.id %>"
                                    style="background: <%= theme.colours['background-colour'] %>; box-shadow: inset 0 0 0 2px <%= theme.colours['nav-active-red'] %>;"
                                    aria-label="Use the <%= theme.name %> theme"></button>
                            <% }); %>
                            <a href="<%= siteConfig.nav.routes.dashboard_themes %>" class="theme-swatch-more" title="More themes">+</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div id="nav-menu-container">
            <ul>
                <!-- Modular item rendering -->
                <% siteConfig.nav.items.forEach(function(item) { %>
                    <li class="nav-item">
                        <a id="<%= item.id %>" 
                            class="nav-link <%= currentPath === item.path ? 'active' : '' %>" href="<%= item.path %>">
                            <%= item.label %>
                        </a>
                    </li>
                <% }); %>
            </ul>
        </div>
    </div>
</nav>